#    1. https://script.google.com par jayein aur "New Project" banayein.
#    2. docs/GOOGLE-APPS-SCRIPT-EMAIL.md se Code.gs copy-paste karein.
#    3. "Deploy" -> "New deployment" -> Web App select karein.
#    4. "Execute as: Me" aur "Who has access: Anyone" select karke Deploy karein.
#    5. Web App URL copy karein.
# 👁️ Kaisa Dikhega:
#    GAS_WEBAPP_URL="https://script.google.com/macros/s/AKfycbx.../exec"
#    GAS_SECRET_TOKEN="your_shared_secret_phrase"
# 💡 Kyu Chahiye:
#    Magic link login, 6-digit OTP, forgot password aur team invites bina kisi domain verification ke bhejne ke liye.
GAS_WEBAPP_URL=""
GAS_SECRET_TOKEN=""

# ----------------------------------------------------------------------------------
# 2. RESEND_API_KEY [🟡 OPTIONAL]
# ----------------------------------------------------------------------------------
# 📍 Kahan Milega: https://resend.com -> API Keys -> Create API Key (3,000 emails/month Free)
# 👁️ Kaisa Dikhega: "re_123456789_abcdefghijklmnopqrstuvwxyz"
# 💡 Kyu Chahiye: Jab koi recipient aapka link open kare to email alert pane ke liye.
RESEND_API_KEY=""

# ----------------------------------------------------------------------------------
# 3. BREVO_API_KEY [🟡 OPTIONAL]
# ----------------------------------------------------------------------------------
# 📍 Kahan Milega: https://app.brevo.com -> SMTP & API -> API Keys (300 emails/day Free)
# 👁️ Kaisa Dikhega: "xkeysib-123456789abcdef..."
BREVO_API_KEY=""

# ----------------------------------------------------------------------------------
# 4. CUSTOM SMTP / GMAIL [🟡 OPTIONAL]
# ----------------------------------------------------------------------------------
SMTP_HOST=""                                      # e.g. smtp.gmail.com
SMTP_PORT="587"
SMTP_SECURE="false"                               # true for port 465, false for 587
SMTP_USER=""                                      # your-email@gmail.com
SMTP_PASS=""                                      # 16-character Google App Password
