# ═══ BLINDSHARE .env.example — (real .env KABHI commit NAHI!) ═══
# BRAND (khud-ka-brand = sirf ye 3-4 badal ke rebrand! 🏷️)
PUBLIC_APP_NAME="BlindShare"        # ← apna brand likhna (env-only rebrand)
PUBLIC_BRAND_LOGO_URL="/brand/logo.svg"
PUBLIC_BRAND_ACCENT="#f59e0b"
PUBLIC_APP_URL="https://docs.blindshare.example.com"
APP_NAME="BlindShare"
BACKEND_TARGET="cf"            # cf | vercel | netlify | deno
DB_TARGET="d1"                 # d1 | neon | turso | supabase
STORE_TARGET="r2"              # r2 | b2
NODE_ENV="production"
SESSION_SECRET="e9f02938475a1b2c3d4e5f60718293a4b5c6d7e8f90123456789abcdef012345"
PUBLIC_API_BASE_URL="https://api.blindshare.workers.dev"
PUBLIC_UI_LANG_DEFAULT="hi"    # en | hi
DOCS_ENCRYPTION_MODE="e2ee-fragment"   # e2ee-fragment | plain-cipher-at-rest
# ☁️ CLOUDFLARE PRIMARY (D1/KV = wrangler bindings)
CF_ACCOUNT_ID="<CF Account ID>"
CF_API_TOKEN="<token Workers/Pages/D1/KV/R2-edit>"
D1_DATABASE_ID="<wrangler d1 create blindshare-db → id>"
KV_NAMESPACE_ID="<wrangler kv namespace create blindshare-kv → id>"
R2_ACCOUNT_ID="<CF Account ID>"
R2_ACCESS_KEY_ID="<R2 S3 token Access Key>"
R2_SECRET_ACCESS_KEY="<Secret>"
R2_BUCKET="blindshare-cipher"
# 🐘 NEON
DATABASE_URL="postgres://<user>:<pass>@<host>.neon.tech/blindshare?sslmode=require"
# 🌀 TURSO
TURSO_DATABASE_URL="libsql://blindshare-<org>.turso.io"
TURSO_AUTH_TOKEN="<turso db tokens create → JWT>"
# 🟢 SUPABASE
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_ANON_KEY="<anon>"
SUPABASE_SERVICE_ROLE_KEY="<service_role — server-side only!>"
SUPABASE_DB_URL="postgres://postgres:<pass>@db.<ref>.supabase.co:5432/postgres"
# ⚡ DENO
DENO_DEPLOY_TOKEN="<dash.deno.com token>"
DENO_KV_URL=""
# 🪣 B2 — PRIVATE ONLY (Master Key KABHI NAHI, regular Application-Key!)
B2_ENDPOINT="s3.us-east-005.backblazeb2.com"
B2_REGION="us-east-005"
B2_BUCKET="<NAYI private bucket — messenger/PB buckets se ALAG naam>"
B2_KEY_ID="<bucket-specific App Key keyID>"
B2_APPLICATION_KEY="<blue-box applicationKey>"
B2_PRESIGN_PUT_EXPIRY_SEC="600"
B2_PRESIGN_GET_EXPIRY_SEC="300"
# 🔔 PUSH
VAPID_PUBLIC_KEY="<npx web-push generate-vapid-keys → public>"
VAPID_PRIVATE_KEY="<private — secret!>"
VAPID_SUBJECT="mailto:<mera-email@example.com>"
# 👑 ADMIN / LIMITS (abuse-defence)
ADMIN_BOOTSTRAP_INVITE="blindshare-genesis-admin-2026"
INVITE_EXPIRY_DAYS="7"
MAX_FILE_MB="25"               # B2-egress budget rule! (docs/images/audio)
MAX_VIDEO_MB="50"              # video-only cap (egress-heavy — ledger-line alag!)
UPLOADS_PER_DAY="20"
PRESIGN_REQ_PER_MIN_PER_IP="20"
VIEWS_PER_HR_PER_LINK="120"
PWD_GATE_LOCKOUT_TRIES="5"
VIEW_HEARTBEAT_SEC="10"
ANALYTICS_FLUSH_MIN="60"
PAGE_EVENTS_RETENTION_DAYS="180"
AUDIT_RETENTION_DAYS="30"
DOC_TTL_SWEEP_DAYS="0"         # 0 = keep-till-delete; >0 auto-purge
# 📧 EMAIL (OPTIONAL — default off; needs domain+Resend/SMTP)
EMAIL_ENABLED="false"
RESEND_API_KEY=""
MAIL_FROM=""
# 📡 ABLY (sirf agar ALT-A live-presence)
ABLY_API_KEY=""
# 📊 OPS
BUDGET_WARN_PERCENT="80"
HEALTH_TOKEN="health-blindshare-ops-token-2026"
MAINTENANCE_MODE="false"
BOT_WEBHOOK_URL="<optional — BLINDSHARE-MESSENGER bot / generic webhook for first-open+milestones 🔐🤝>"
# 🛡️ ADVANCED SECURITY HARDENING (additive — strict-by-default, tune per host)
LOGIN_LOCKOUT_TRIES="5"        # owner-login brute-force lockout threshold
LOGIN_LOCKOUT_MINUTES="15"     # cool-down once LOGIN_LOCKOUT_TRIES is hit
PASSWORD_MIN_LENGTH="10"       # min length enforced client+server (+upper/lower/digit/symbol)
BCRYPT_COST_FACTOR="12"        # bcrypt rounds for owner password hashes (10-15)
SESSION_MAX_AGE_DAYS="30"      # signed session-cookie lifetime
