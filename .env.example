# ==================================================================================
# 🏷️ 1. BRAND & CORE CONFIGURATION
# ==================================================================================
# [Kahan milega]: Aapki marzi ka custom brand name, logo aur default UI bhasha
# [Kaisa dikhega]: Text string ("BlindShare", "hi" ya "en", hex color)
PUBLIC_APP_NAME="BlindShare"
PUBLIC_UI_LANG_DEFAULT="hi"                  # 'hi' (Hindi) | 'en' (English)
PUBLIC_BRAND_ACCENT="#f59e0b"                # Theme accent color hex
PUBLIC_BRAND_LOGO_URL="/brand/logo.svg"      # Custom company logo image URL
PUBLIC_APP_URL="https://blindshare.example.com"
APP_NAME="blindshare"
BACKEND_TARGET="vercel"                      # 'vercel' | 'cf' (Cloudflare) | 'netlify' | 'deno'
DB_TARGET="neon"                             # 'neon' | 'd1' | 'turso' | 'supabase'
STORE_TARGET="local"                         # 'local' (Free dev/staging) | 'r2' | 'b2'
DOCS_ENCRYPTION_MODE="e2ee-fragment"         # 'e2ee-fragment' (Zero-Knowledge) | 'plain-cipher-at-rest'
NODE_ENV="production"
MAINTENANCE_MODE="false"

# ==================================================================================
# 👑 2. ADMIN CREDENTIALS & SESSIONS (Deployer Operator Only)
# ==================================================================================
# [Kahan milega]:
# - SESSION_SECRET: Terminal me run karein: `node -e "console.log(crypto.randomBytes(32).toString('hex'))"`
# - ADMIN_BOOTSTRAP_INVITE: Pehli bar register karte waqt super-admin banne ka secret code
# - HEALTH_TOKEN: `/api/health` deep status check karne ke liye auth bearer token
# [Kaisa dikhega]:
SESSION_SECRET="e9f02938475a1b2c3d4e5f60718293a4b5c6d7e8f90123456789abcdef012345"
ADMIN_BOOTSTRAP_INVITE="BLINDSHARE-GENESIS-2026"
HEALTH_TOKEN="health_secret_token_blindshare_99x"
PASSWORD_MIN_LENGTH="10"                     # Min password length (at least 10 chars, uppercase, digit, symbol)
BCRYPT_COST_FACTOR="12"                      # Password hashing strength factor (10-15)
SESSION_MAX_AGE_DAYS="30"                    # Cookie expiration lifetime (Days)

# ==================================================================================
# 📊 3. POLICY MATRIX & SECURITY LIMITS
# ==================================================================================
# [Kahan milega]: System security rate-limits aur file size caps
# [Kaisa dikhega]: Numbers (MB, Minutes, counts)
MAX_FILE_MB="25"                             # Standard documents (PDF, Images, Markdown) max size in MB
MAX_VIDEO_MB="50"                            # Video media attachments max size in MB
UPLOADS_PER_DAY="30"                         # 1 user per day kitne files upload kar sakta hai
VIEWS_PER_HR_PER_LINK="120"                  # Anti-scraping rate limit per link per hour
PWD_GATE_LOCKOUT_TRIES="5"                   # Wrong password attempts before link lockout
LOGIN_LOCKOUT_TRIES="5"                      # Wrong admin/owner login attempts before lockout
LOGIN_LOCKOUT_MINUTES="15"                   # Lockout duration in minutes
VIEW_HEARTBEAT_SEC="10"                      # Per-page dwell time flush frequency (Seconds)
ANALYTICS_FLUSH_MIN="60"                     # Batch aggregate background flush interval
DOC_TTL_SWEEP_DAYS="0"                       # 0 = keep until manual delete, >0 = auto-purge expired documents

# ==================================================================================
# ☁️ 4. CLOUDFLARE INFRASTRUCTURE (₹0 Free Tier)
# ==================================================================================
# [Kahan milega]:
# - CF_ACCOUNT_ID: Cloudflare Dashboard -> Right Sidebar -> Account ID
# - CF_API_TOKEN: Cloudflare Dashboard -> My Profile -> API Tokens -> Create Custom Token (Workers, D1, KV Edit)
# - D1_DATABASE_ID: Terminal me run karein: `npx wrangler d1 create blindshare-db`
# - KV_NAMESPACE_ID: Terminal me run karein: `npx wrangler kv namespace create blindshare-kv`
# [Kaisa dikhega]:
CF_ACCOUNT_ID="your_cf_account_id_32_chars_hex"
CF_API_TOKEN="your_cf_custom_api_token_here"
D1_DATABASE_ID="00000000-0000-0000-0000-000000000000"
KV_NAMESPACE_ID="your_kv_namespace_id_32_chars_hex"

# ==================================================================================
# 🪣 5. CLOUDFLARE R2 STORAGE (Zero-Egress Document Ciphertext Vault)
# ==================================================================================
# [Kahan milega]: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
# [Kaisa dikhega]:
R2_ACCOUNT_ID="your_cf_account_id_32_chars_hex"
R2_ACCESS_KEY_ID="your_r2_access_key_id_here"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key_here"
R2_BUCKET="blindshare-vault"

# ==================================================================================
# 🪣 6. BACKBLAZE B2 STORAGE (Alternative Private S3 Bucket)
# ==================================================================================
# [Kahan milega]: Backblaze B2 Console -> App Keys -> Add a New Application Key (Read/Write)
# [Kaisa dikhega]:
B2_ENDPOINT="s3.us-east-005.backblazeb2.com"
B2_REGION="us-east-005"
B2_BUCKET="blindshare-ephemeral-private"
B2_KEY_ID="your_b2_key_id_here"
B2_APPLICATION_KEY="your_b2_application_key_here"
B2_PRESIGN_PUT_EXPIRY_SEC="600"
B2_PRESIGN_GET_EXPIRY_SEC="300"

# ==================================================================================
# 🐘 7. SQL DATABASES (Neon Serverless Postgres / Turso / Supabase)
# ==================================================================================
# [Kahan milega]:
# - Neon: https://console.neon.tech -> Dashboard -> Connection String (-pooler URL)
# - Turso: https://turso.tech -> `turso db show <name>` -> Database URL + Auth Token
# - Supabase: https://supabase.com -> Project Settings -> Database -> Connection URL
# [Kaisa dikhega]:
DATABASE_URL="postgres://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/blindshare?sslmode=require"
TURSO_DATABASE_URL="libsql://blindshare-sample.turso.io"
TURSO_AUTH_TOKEN="your_turso_auth_token_jwt"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key_jwt"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_jwt"
SUPABASE_DB_URL="postgres://postgres:password@db.your-project.supabase.co:5432/postgres"

# ==================================================================================
# 🔔 8. REAL-TIME NOTIFICATIONS & WEBHOOKS (Discord / Slack / Push)
# ==================================================================================
# [Kahan milega]:
# - BOT_WEBHOOK_URL: Discord Server Settings -> Integrations -> Webhooks -> Copy Webhook URL
# - VAPID Keys: Terminal me run karein: `npx web-push generate-vapid-keys`
# [Kaisa dikhega]:
BOT_WEBHOOK_URL="https://discord.com/api/webhooks/1234567890/example_discord_token"
VAPID_PUBLIC_KEY="example_vapid_public_key_base64_string"
VAPID_PRIVATE_KEY="example_vapid_private_key_base64_string"
VAPID_SUBJECT="mailto:admin@blindshare.example.com"

# ==================================================================================
# 📈 9. PRIVACY-RESPECTING ANALYTICS & OPS TELEMETRY (Optional)
# ==================================================================================
# [Kahan milega]: MeraAnalytics / Umami / Prism Analytics Worker
# [Kaisa dikhega]:
NEXT_PUBLIC_MERA_ANALYTICS_SRC=""
NEXT_PUBLIC_MERA_ANALYTICS_ID=""
NEXT_PUBLIC_PRISM_ANALYTICS_ID=""
NEXT_PUBLIC_PRISM_ANALYTICS_URL=""
BUDGET_WARN_PERCENT="80"
